# Copy to .env next to compose.yaml and adjust.

# Interface the dashboard is published on. The dashboard has no auth:
# keep it on 127.0.0.1 or a private (e.g. Tailscale) address.
SPONDEX_BIND=127.0.0.1
SPONDEX_PORT=9847

# Host directory with config.toml, spondex.db and logs.
SPONDEX_DATA_DIR=./data

# Must match the owner of SPONDEX_DATA_DIR on the host (id -u / id -g).
SPONDEX_UID=1000
SPONDEX_GID=1000

TZ=UTC
